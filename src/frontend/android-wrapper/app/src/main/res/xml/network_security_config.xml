<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce HTTPS-only by default (no cleartext traffic) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Allow HTTPS connections to Internet Computer domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">ic0.app</domain>
        <domain includeSubdomains="true">icp0.io</domain>
        <domain includeSubdomains="true">internetcomputer.org</domain>
    </domain-config>
</network-security-config>
